MINECRAFT_VERSION=1.21.4
MODLOADER=Fabric
MODLOADER_VERSION=0.16.10
RECOMMENDED_JAVA_VERSION=21
JAVA_ARGS="-Xms128M -XX:MaxRAMPercentage=95.0 -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1 -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true"
JAVA="java"
WAIT_FOR_USER_INPUT=true
ADDITIONAL_ARGS=-Dlog4j2.formatMsgNoLookups=true
RESTART=true
SKIP_JAVA_CHECK=false
JDK_VENDOR=temurin
BOOTSTRAP_FORCE_FETCH=true
BOOTSTRAP_VERSION=latest
PACKWIZ_URL=https://raw.githubusercontent.com/unately/uBingo/v2/pack.toml
